              class:list={{
                active: currentPath.endsWith("/software-licensing"),
              }}>Software Licensing</a
            >
            <a
              href="/solutions/products"
              class:list={{
                active: currentPath.endsWith("/products"),
              }}>Products</a
            >
          </div>
        </div>
        <a
          href="/partners/partner"
