---
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header>
  <nav>
    <div class="quick-contact"><p>Contact Us : (+95) 9 799 476854</p></div>
    <div class="nav-inner">
      <a href="/" class="logo"><img src="/images/logo/bim-logo.png" alt="" /></a
      >
      <div class="links">
        <div class="IT-services">
          <a
            href="/services/it-services"
            class:list={{
              active: currentPath.startsWith("/services/"),
            }}
            >IT SERVICES
          </a>
          <div class="dropdown1 dropdown">
            <a
              href="/services/it-outsourcing"
              class:list={{
                active: currentPath.endsWith("/it-outsourcing"),
              }}>IT Outsourcing</a
            >
            <a
              href="/services/manage-it-services"
              class:list={{
                active: currentPath.endsWith("/manage-it-services"),
              }}>Manage IT Service</a
            >

            <a
              href="/services/it-infra-management"
              class:list={{
                active: currentPath.endsWith("/it-infra-management"),
              }}>IT Infra Management</a
            >
            <a
              href="/services/it-service-management-and-governance"
              class:list={{
                active: currentPath.endsWith(
                  "/it-service-management-and-governance",
                ),
              }}>IT Service Management & Governance</a
