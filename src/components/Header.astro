                active: currentPath.endsWith("/end-user-it-services"),
              }}>End User IT Services</a
            >
            <a
              href="/services/hardware-software-maintenance"
              class:list={{
                active: currentPath.endsWith("/hardware-software-maintenance"),
              }}>Hardware/Software Maintenance</a
            >
            <a
              href="/services/regional-coverage"
              class:list={{
                active: currentPath.endsWith("/regional-coverage"),
              }}>Regional Coverage</a
            >
            <a
              href="/services/cloud-integrating-service"
              class:list={{
                active: currentPath.endsWith("/cloud-integrating-service"),
              }}>Cloud Integrating Service</a
            >
            <a
              href="/services/cyber-security"
              class:list={{
                active: currentPath.endsWith("/cyber-security"),
              }}>Cyber Security</a
            >
            <a
              href="/services/maintenance-support-services"
              class:list={{
                active: currentPath.endsWith("/maintenance-support-services"),
              }}>Maintenance Support Services</a
            >
          </div>
        </div>

        <div class="solutions">
          <a
            href="/solutions/solution"
            class:list={{
              active: currentPath.startsWith("/solutions/"),
            }}>SOLUTIONS</a
          >
          <div class="dropdown2 dropdown">
            <a
              href="/solutions/virtual-desktop-infrastructure"
              class:list={{
                active: currentPath.endsWith("/virtual-desktop-infrastructure"),
              }}>Virtual Desktop Infrastructure</a
            >
            <a
              href="/solutions/voice-over-ip"
              class:list={{
                active: currentPath.endsWith("/voice-over-ip"),
              }}>Voice Over IP</a
            >
            <a
              href="/solutions/video-conferencing"
              class:list={{
                active: currentPath.endsWith("/video-conferencing"),
              }}>Video Conferencing</a
            >
            <a
              href="/solutions/cabling-services"
              class:list={{
                active: currentPath.endsWith("/cabling-services"),
              }}>Cabling Services</a
