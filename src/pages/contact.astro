---
import InnerLayout from "../layouts/InnerLayout.astro";
---

<InnerLayout>
  <section class="contact">
    <div class="container">
      <h2>Contact Us</h2>
      <h3>We value your enquiry !</h3>
      <h4>
        Any enquiry, please contact our sale coordinator at: +95 9 799 476854 or
        email: sales@bimats.com.
      </h4>
      <p>
        You can contact to us through the form. Your information will be kept
        confidential. We will response back to you as soon as.
      </p>
      <div class="container-inner">
        <div class="form-container">
          <form action="">
            <input type="text" name="user-name" placeholder="Your Name" />
            <input type="email" name="user-email" placeholder="Email" />
            <input type="text" name="subject" placeholder="Subject" />
            <textarea name="message" placeholder="How may we help?"></textarea>
            <button type="submit">Send</button>
          </form>
        </div>
        <div class="info-container">
          <div class="inner-info">
            <div class="img-container">
              <img src="/images/icons/maps-and-flags.png" alt="" />
            </div>
            <p>
              G 102 & 105 , Diamond Tower, Corner of Pyay Road and Nar Nat Taw
              Road , Kamaryut Township , Yangon , Myanmar
            </p>
          </div>
          <div class="inner-info">
            <div class="img-container">
              <img src="/images/icons/phone-call.png" alt="" />
            </div><p>+95 9 799 476854</p>
          </div>
          <div class="inner-info">
            <div class="img-container">
              <img src="/images/icons/mail.png" alt="" />
            </div><p>sales@bimats.com</p>
          </div>
          <div class="inner-info">
            <p>Follow Us :</p>
            <div class="social-container">
              <img src="/images/icons/facebook.png" alt="" />
            </div>
            <div class="social-container">
              <img src="/images/icons/linkedin.png" alt="" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</InnerLayout>
