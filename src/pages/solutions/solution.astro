---
import InnerLayout from "../../layouts/InnerLayout.astro";
---

<InnerLayout>
  <section class="it-services-section">
    <div class="container">
      <div class="title">
        <div class="img-container">
          <img src="/images/solutions/solution-icon.png" />
        </div>
        <h1>SOLUTIONS</h1>
      </div>
      <p>
        We offer a comprehensive range of services to help design, deploy,
        manage and support your IT environment. Our skilled IT professionals
        deliver global services capabilities across the IT lifecycle, including
        consulting, integration, outsourcing and support. Our support is offered
        on a full-time, part-time or project basis, either on-site or remotely.
        We can provide any level of service from bench services and on-call
        emergency support to being your outsourced IT department.Our services
        include:
      </p>
      <div class="container-inner">
        <div class="img-container">
          <img src="/images/solutions/solution.jpeg" alt="" />
        </div>
        <div class="ul-container">
          <ul>
            <li><a href="">Virtual Desktop Infrastructure</a></li>
            <li><a href="">Voice Over IP</a></li>
            <li><a href="">Video Conferencing</a></li>
            <li><a href="">Cabling Services</a></li>
            <li><a href="">Storage Solutions</a></li>
            <li><a href="">Collaboration Solutions</a></li>
            <li><a href="">Software Licensing</a></li>
            <li><a href="">Products</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</InnerLayout>
