---
import InnerLayout from "../../layouts/InnerLayout.astro";
import LinkBox from "../../components/ITserviceLinkBox.astro";
---

<InnerLayout>
  <section class="it-services-all">
    <div class="container">
      <LinkBox />
      <div class="text-container">
        <h3>CONSULTING SERVICES</h3>
        <p>
          We offer IT consulting services that will help you improve your IT
          infrastructure, create a tech-driven digital strategy, and improve
          operations by optimizing your infrastructure. Our engineers will
          finish your digital transformation journey through careful planning
          and effective execution of the outlined IT strategy.
        </p>
        <p>
          Our IT experts have worked in the industries for over fifteen years.
          This has allowed us to craft an effective approach to IT consulting
          that enables us to deliver maximum benefit in the shortest time.
        </p>
        <p>
          <a href="/contact">CONTACT US</a>TODAY TO DISCUSS CONSULTING SERVICES?
        </p>
      </div>
      <div class="img-container">
        <img src="/images/icons/technology.jpg" alt="" />
      </div>
    </div>
  </section>
</InnerLayout>
