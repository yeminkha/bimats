---
import InnerLayout from "../../layouts/InnerLayout.astro";
import LinkBox from "../../components/ITserviceLinkBox.astro";
---

<InnerLayout>
  <section class="it-services-all">
    <div class="container">
      <LinkBox />
      <div class="text-container">
        <h3>MAINTENANCE SUPPORT SERVICES</h3>
        <p>
          BIM literally has the ability to dispatch service technicians anywhere
          in the country, thereby becoming a single point of reference for your
          technology needs anywhere within your enterprise. Currently, our team
          has wide range throughout Yangon, Mandalay and Nay Pyi Taw with high
          prestige in customer success and management services.
        </p>
        <p>
          <a href="/contact">CONTACT US</a>TODAY TO DISCUSS MAINTENANCE SUPPORT SERVICES ?
        </p>
      </div>
      <div class="img-container">
        <img src="/images/icons/technology.jpg" alt="" />
      </div>
    </div>
  </section>
</InnerLayout>
