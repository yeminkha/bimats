---
import InnerLayout from "../../layouts/InnerLayout.astro";
import LinkBox from "../../components/ITserviceLinkBox.astro";
---

<InnerLayout>
  <section class="it-services-all">
    <div class="container">
      <LinkBox />
      <div class="text-container">
        <h3>END USER IT SERVICES</h3>
        <p>
          End User Help Desk Support Services provide end users with remote
          assistance for their workstations and associated peripherals, and
          guarantee that an engineer will be assigned to their needs within an
          arranged period in advance.
        </p>
        <p>
          <a href="/contact">CONTACT US</a>TODAY TO DISCUSS END USER IT SERVICES?
        </p>
      </div>
      <div class="img-container">
        <img src="/images/icons/technology.jpg" alt="" />
      </div>
    </div>
  </section>
</InnerLayout>
